# Copy to .env; never commit filled credentials or print this file.
# Paths are resolved from the repository root.
SFT_PYTHON=./.venv-sft/bin/python
OPSD_PYTHON=./.venv-opsd/bin/python

# Assign only GPUs allocated to you. Groups must be disjoint.
# Use eight physical indices OR eight UUIDs, not a mixture.
BASELINE_GPUS=0,1,2,3
METHOD_GPUS=4,5,6,7
RAY_ADDRESS=local
ALFWORLD_DATA=./data/alfworld

# Own HTTPS chat-completions provider; required only for method OPSD.
# Empty defaults preserve securely injected environment variables.
RETHINK_API_ENDPOINT=${RETHINK_API_ENDPOINT:-}
RETHINK_API_KEY=${RETHINK_API_KEY:-}
RETHINK_API_CONCURRENCY=4
HF_TOKEN=${HF_TOKEN:-}

# Optional standalone final evaluation: ONE allocated GPU after training exits.
# EVAL_GPU=0
# Optional existing writable short temporary parent (<=25 bytes on Linux).
# RETHINK_RUNTIME_ROOT=/tmp
