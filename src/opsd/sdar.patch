+++ b/verl/trainer/ppo/rethink_checkpoint_io.py
@@ -0,0 +1,155 @@
+"""CPU-only, fail-closed checkpoint transactions scoped to one authorized run."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import time
+
+SCHEMA = "sdar_complete_recovery_v1"
+REQUIRED = ["actor/model_world_size_1_rank_0.pt", "actor/optim_world_size_1_rank_0.pt",
+            "actor/extra_state_world_size_1_rank_0.pt", "actor/config.json",
+            "actor/tokenizer.json", "data.pt", "driver_state.pt"]
+
+
+def sha(path):
+    h = hashlib.sha256()
+    with Path(path).open("rb") as f:
+        for block in iter(lambda: f.read(8 * 1024**2), b""):
+            h.update(block)
+    return h.hexdigest()
+
+
+def fsync_dir(path):
+    fd = os.open(str(path), os.O_RDONLY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def atomic_json(path, value):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    pending = path.with_name(path.name + ".pending")
+    with pending.open("w", encoding="utf-8") as f:
+        json.dump(value, f, indent=2)
+        f.flush()
+        os.fsync(f.fileno())
+    pending.replace(path)
+    fsync_dir(path.parent)
+
+
+def checked(root, folder, contract_sha, full_hash=False):
+    root, folder = Path(root).resolve(), Path(folder)
+    if folder.is_symlink() or folder.resolve().parent != root:
+        raise ValueError("CHECKPOINT_SCOPE_MISMATCH")
+    if not re.fullmatch(r"global_step_\d+", folder.name):
+        raise ValueError("NOT_A_COMMITTED_CHECKPOINT")
+    m = json.loads((folder / "complete.json").read_text())
+    if m["schema"] != SCHEMA or m["contract_sha256"] != contract_sha:
+        raise ValueError("CHECKPOINT_CONTRACT_MISMATCH")
+    if m["step"] != int(folder.name.split("_")[-1]) or not set(REQUIRED) <= set(m["files"]):
+        raise ValueError("CHECKPOINT_MEMBERS_MISSING")
+    for name, expected in m["files"].items():
+        p = folder / name
+        if p.is_symlink() or not p.resolve().is_relative_to(folder.resolve()):
+            raise ValueError("CHECKPOINT_MEMBER_SCOPE_MISMATCH")
+        if not p.is_file() or p.stat().st_size != expected["bytes"] or expected["bytes"] <= 0:
+            raise ValueError("CHECKPOINT_MEMBER_INCOMPLETE")
+        if full_hash and sha(p) != expected["sha256"]:
+            raise ValueError("CHECKPOINT_MEMBER_HASH_MISMATCH")
+    return m
+
+
+def latest(root, contract_sha, full_hash=False):
+    root = Path(root)
+    candidates = sorted((p for p in root.glob("global_step_*")
+                         if re.fullmatch(r"global_step_\d+", p.name)),
+                        key=lambda p: int(p.name.split("_")[-1]), reverse=True)
+    errors = []
+    for p in candidates:
+        try:
+            return p, checked(root, p, contract_sha, full_hash)
+        except (ValueError, KeyError, OSError, json.JSONDecodeError) as exc:
+            errors.append({"path": p.name, "error_type": type(exc).__name__})
+    if candidates:
+        raise RuntimeError("NO_VALID_CHECKPOINT_REFUSE_RESET_TO_ZERO")
+    return None, None
+
+
+def remove_owned(root, folder, contract_sha, partial=False):
+    root, folder = Path(root).resolve(), Path(folder)
+    pattern = r"global_step_\d+\.pending" if partial else r"global_step_\d+"
+    if folder.is_symlink() or folder.resolve().parent != root or not re.fullmatch(pattern, folder.name):
+        raise ValueError("REFUSE_UNSCOPED_CHECKPOINT_DELETE")
+    marker = json.loads((folder / ("transaction.json" if partial else "complete.json")).read_text())
+    if marker["contract_sha256"] != contract_sha:
+        raise ValueError("REFUSE_FOREIGN_CHECKPOINT_DELETE")
+    atomic_json(root / "checkpoint_history" / (folder.name + ".removed.json"),
+                {"time": time.time(), "path": str(folder), "partial": partial, "manifest": marker})
+    shutil.rmtree(folder)
+
+
+def prepare(root, step, contract_sha, minimum_free=None):
+    root = Path(root).resolve()
+    # Only our own abandoned, explicitly tagged transactions may be removed.
+    for p in root.glob("global_step_*.pending"):
+        remove_owned(root, p, contract_sha, partial=True)
+    complete = sorted((p for p in root.glob("global_step_*")
+                       if re.fullmatch(r"global_step_\d+", p.name)),
+                      key=lambda p: int(p.name.split("_")[-1]))
+    for p in complete:
+        checked(root, p, contract_sha)
+    # Always keep the newest committed checkpoint while writing a replacement.
+    need = minimum_free if minimum_free is not None else max(
+        38 * 2**30, max((sum(x["bytes"] for x in checked(root, p, contract_sha)["files"].values())
+                         for p in complete), default=0) + 2 * 2**30)
+    while len(complete) > 1 and (len(complete) >= 2 or shutil.disk_usage(root).free < need):
+        remove_owned(root, complete.pop(0), contract_sha)
+    if shutil.disk_usage(root).free < need:
+        raise RuntimeError("CHECKPOINT_DISK_HOLD_LAST_COMPLETE_PRESERVED")
+    final = root / f"global_step_{step}"
+    if final.exists():
+        raise ValueError("REFUSE_OVERWRITE_COMPLETE_CHECKPOINT")
+    pending = root / (final.name + ".pending")
+    pending.mkdir()
+    atomic_json(pending / "transaction.json", {"step": step, "contract_sha256": contract_sha})
+    return pending
+
+
+def commit(root, pending, step, contract_sha):
+    root, pending = Path(root).resolve(), Path(pending)
+    if pending.resolve().parent != root or pending.name != f"global_step_{step}.pending":
+        raise ValueError("CHECKPOINT_TRANSACTION_SCOPE_MISMATCH")
+    transaction = json.loads((pending / "transaction.json").read_text())
+    if transaction != {"step": step, "contract_sha256": contract_sha}:
+        raise ValueError("CHECKPOINT_TRANSACTION_CONTRACT_MISMATCH")
+    for name in REQUIRED:
+        if not (pending / name).is_file() or (pending / name).stat().st_size <= 0:
+            raise ValueError("CHECKPOINT_INCOMPLETE_BEFORE_COMMIT")
+    files = {}
+    for p in sorted(pending.rglob("*")):
+        if p.is_symlink():
+            raise ValueError("CHECKPOINT_SYMLINK_REFUSED")
+        if p.is_file():
+            with p.open("rb") as f:
+                os.fsync(f.fileno())
+            files[str(p.relative_to(pending))] = {"bytes": p.stat().st_size, "sha256": sha(p)}
+    m = {"schema": SCHEMA, "step": step, "contract_sha256": contract_sha,
+         "committed_at": time.time(), "files": files}
+    atomic_json(pending / "complete.json", m)
+    final = root / f"global_step_{step}"
+    if final.exists():
+        raise ValueError("REFUSE_OVERWRITE_COMPLETE_CHECKPOINT")
+    pending.rename(final)
+    fsync_dir(root)
+    atomic_json(root / "latest_complete_checkpoint.json", {"step": step, "path": final.name,
+                                                           "contract_sha256": contract_sha})
+    marker = root / "latest_checkpointed_iteration.txt"
+    with marker.with_suffix(".pending").open("w") as f:
+        f.write(str(step)); f.flush(); os.fsync(f.fileno())
+    marker.with_suffix(".pending").replace(marker)
+    fsync_dir(root)
+    return m
