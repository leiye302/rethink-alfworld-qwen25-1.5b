new file mode 100644
--- /dev/null
+++ b/verl/models/transformers/dense_common.py
@@ -0,0 +1,80 @@
+# Copyright 2026. Licensed under the Apache License, Version 2.0.
+"""Memory-bounded dense scoring for the existing VERL fused-forward interface.
+
+This is deliberately NOT a new loss or approximate softmax. Each token uses the
+original full-vocabulary log-probability and entropy functions. Only the LM-head
+token dimension is chunked, and its intermediates are recomputed in backward.
+The public actor updater (including all reductions and microbatches) is unchanged.
+"""
+from functools import lru_cache
+from typing import NamedTuple
+
+import torch
+from torch.utils.checkpoint import checkpoint
+
+
+class DenseScoringOutput(NamedTuple):
+    # FSDP must traverse these tensors to install its pre-backward all-gather.
+    # An opaque SimpleNamespace would bypass that hook and invalidate weights.
+    log_probs: torch.Tensor
+    entropy: torch.Tensor
+
+
+@lru_cache(maxsize=1)
+def _native_functions():
+    from verl.utils.torch_functional import logprobs_from_logits, entropy_from_logits
+    return logprobs_from_logits, torch.compile(entropy_from_logits, dynamic=True)
+
+
+def chunked_scores(hidden, weight, labels, temperature, chunk_size=512, *,
+                   logprob_fn=None, entropy_fn=None):
+    """Return native per-token scores; no change to batch/loss normalization."""
+    if logprob_fn is None or entropy_fn is None:
+        logprob_fn, entropy_fn = _native_functions()
+    if chunk_size < 1 or temperature <= 0:
+        raise ValueError('Positive chunk size and temperature required')
+    shape = labels.shape
+    flat = hidden.reshape(-1, hidden.shape[-1])
+    targets = labels.reshape(-1)
+    assert flat.shape[0] == targets.numel()
+
+    def score(h, w, y):
+        logits = torch.nn.functional.linear(h, w)
+        logits.div_(temperature)
+        logp = logprob_fn(logits, y, inplace_backward=False)
+        entropy = entropy_fn(logits)
+        return logp, entropy
+
+    probs, entropies = [], []
+    for start in range(0, flat.shape[0], chunk_size):
+        args = (flat[start:start+chunk_size], weight, targets[start:start+chunk_size])
+        if torch.is_grad_enabled() and (hidden.requires_grad or weight.requires_grad):
+            p, e = checkpoint(score, *args, use_reentrant=False, preserve_rng_state=False)
+        else:
+            p, e = score(*args)
+        probs.append(p)
+        entropies.append(e)
+    return torch.cat(probs).view(shape), torch.cat(entropies).view(shape)
+
+
+def forward_with_torch_backend(self, input_ids=None, attention_mask=None,
+        position_ids=None, past_key_values=None, inputs_embeds=None, labels=None,
+        use_cache=False, temperature=1.0, return_dict=True, **kwargs):
+    # This resource adapter is validated only for our Qwen2 text actor/ref path.
+    if self.config.model_type != 'qwen2' or input_ids is None or labels is not None or use_cache:
+        raise ValueError('Chunked scorer supports Qwen2 text scoring with input_ids and no cache/labels')
+    if getattr(self.lm_head, 'bias', None) is not None:
+        raise ValueError('Qwen2 LM-head bias is expected to be absent')
+    kwargs.pop('logits_to_keep', None)
+    output = self.model(input_ids=input_ids, attention_mask=attention_mask,
+        position_ids=position_ids, past_key_values=past_key_values,
+        inputs_embeds=inputs_embeds, use_cache=False, return_dict=True, **kwargs)
+    # Exactly the same next-token shift as dp_actor._forward_micro_batch.
+    targets = input_ids.roll(shifts=-1, dims=-1)
+    logp, entropy = chunked_scores(output[0], self.lm_head.weight, targets,
+        temperature, chunk_size=512)
+    return DenseScoringOutput(log_probs=logp, entropy=entropy)
+
+
+def forward_with_triton_backend(*args, **kwargs):
+    raise NotImplementedError('Use the validated torch backend, not an unimplemented Triton backend')
