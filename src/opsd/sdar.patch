diff --git a/verl/trainer/ppo/rethink_api_hints.py b/verl/trainer/ppo/rethink_api_hints.py
new file mode 100644
--- /dev/null
+++ b/verl/trainer/ppo/rethink_api_hints.py
@@ -0,0 +1,282 @@
+"""Go-only GLM episode batching. CPU, durable cache, no routing authority."""
+import argparse
+from concurrent.futures import ThreadPoolExecutor, as_completed
+import hashlib
+import http.client
+import importlib.util
+import json
+import os
+from pathlib import Path
+import threading
+import time
+import urllib.error
+import urllib.request
+import uuid
+
+# Keep the standalone API worker free of verl/torch imports and GPU ownership.
+spec = importlib.util.spec_from_file_location("api_protocol", Path(__file__).with_name("rethink_api_protocol.py"))
+protocol = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(protocol)
+ENDPOINT = "https://opencode.ai/inference/go/openai/v1/chat/completions"
+USAGE_ENDPOINT = "https://opencode.ai/zen/go/v1/usage"
+EXECUTION_SCHEMA = "go_episode_api_execution_v1"
+
+
+class TransientAPIError(RuntimeError):
+    """Safe to retry the same request; never contains provider bodies/secrets."""
+
+
+def retry_delay(attempt):
+    return min(60, 2 ** (attempt + 1))
+
+
+def execution_settings(payload, output_path):
+    """Read an allowlisted, run-scoped dispatch override once per CPU batch.
+
+    The live trainer may retain its original declared concurrency. Keep that
+    declaration and the effective override separately in durable results; do
+    not change API bodies, cache identities, route targets, or model settings.
+    """
+    declared = payload.get("concurrency", 2)
+    if type(declared) is not int or not 1 <= declared <= 4:
+        raise ValueError("INVALID_DECLARED_API_CONCURRENCY")
+    root = Path(output_path).resolve().parent.parent
+    config_path = root / "api_execution_config.json"
+    effective, config_sha, change_id = declared, None, None
+    if config_path.exists():
+        raw = config_path.read_bytes()
+        config = json.loads(raw)
+        expected = {"schema", "run_root", "concurrency", "change_id"}
+        if not isinstance(config, dict) or set(config) != expected:
+            raise ValueError("INVALID_API_EXECUTION_CONFIG_FIELDS")
+        if config["schema"] != EXECUTION_SCHEMA:
+            raise ValueError("INVALID_API_EXECUTION_SCHEMA")
+        if not isinstance(config["run_root"], str) or Path(config["run_root"]).resolve() != root:
+            raise ValueError("API_EXECUTION_CONFIG_SCOPE_MISMATCH")
+        effective = config["concurrency"]
+        if type(effective) is not int or not 1 <= effective <= 4:
+            raise ValueError("INVALID_EFFECTIVE_API_CONCURRENCY")
+        change_id = config["change_id"]
+        if not isinstance(change_id, str) or not change_id.strip() or len(change_id) > 160:
+            raise ValueError("INVALID_API_EXECUTION_CHANGE_ID")
+        config_sha = hashlib.sha256(raw).hexdigest()
+    return {"schema": EXECUTION_SCHEMA, "declared_concurrency": declared,
+            "effective_concurrency": effective, "runtime_config_sha256": config_sha,
+            "change_id": change_id,
+            "worker_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+            "protocol_sha256": hashlib.sha256(Path(__file__).with_name("rethink_api_protocol.py").read_bytes()).hexdigest()}
+
+
+def atomic_json(path, value):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    pending = path.with_name(path.name + ".pending")
+    with pending.open("w", encoding="utf-8") as f:
+        json.dump(value, f, ensure_ascii=False, indent=2)
+        f.flush()
+        os.fsync(f.fileno())
+    pending.replace(path)
+
+
+class NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, *args, **kwargs):
+        raise RuntimeError("API_REDIRECT_REFUSED")
+
+
+class GoClient:
+    def __init__(self, auth, cache, max_usd=22.0, session="alfworld-glm-episode-hints-20261015"):
+        self.headers = {**auth.get("headers", {}), "Authorization": "Bearer " + auth["token"],
+                        "Content-Type": "application/json", "User-Agent": "AlfworldHintEvaluation/1.0",
+                        "x-opencode-session": session}
+        self.cache, self.max_usd = Path(cache), float(max_usd)
+        self.cache.mkdir(parents=True, exist_ok=True)
+        self.lock = threading.Lock()
+        self.attempt_dir = self.cache / "attempts"
+        self.attempt_dir.mkdir(exist_ok=True)
+        self.spent, self.reserved, self.calls = 0.0, 0.0, 0
+        self.quota, self.quota_time = None, 0
+        self.quota_spent = 0.0
+        # Count previous durable calls, including malformed responses, on resume.
+        completed_attempts = set()
+        for p in self.cache.glob("*.json"):
+            r = json.loads(p.read_text())
+            self.spent += r.get("uncached_price_upper_usd", 0.0)
+            completed_attempts.add(r.get("attempt_id"))
+        # A lost response may have been billed. Account its worst-case reserve
+        # durably, including a process killed between sending and cache commit.
+        for p in self.attempt_dir.glob("*.json"):
+            r = json.loads(p.read_text())
+            if r["attempt_id"] not in completed_attempts and r["status"] != "cached":
+                self.spent += r["price_upper_usd"]
+
+    def _http(self, url, body=None):
+        request = urllib.request.Request(url, data=None if body is None else json.dumps(body).encode(),
+                                         headers=self.headers, method="GET" if body is None else "POST")
+        opener = urllib.request.build_opener(NoRedirect)
+        try:
+            with opener.open(request, timeout=120) as response:
+                billing = response.headers.get("x-zen-billing-source")
+                if billing is not None and billing != "go":
+                    raise RuntimeError("BILLING_SOURCE_MISMATCH")
+                return json.load(response), billing
+        except urllib.error.HTTPError as exc:
+            # Never echo provider bodies, URLs with tokens, or request headers.
+            if exc.code in {408, 429, 500, 502, 503, 504}:
+                raise TransientAPIError("GO_HTTP_" + str(exc.code)) from None
+            raise RuntimeError("GO_HTTP_" + str(exc.code)) from None
+        except (urllib.error.URLError, TimeoutError, ConnectionError,
+                http.client.RemoteDisconnected, http.client.IncompleteRead):
+            raise TransientAPIError("GO_TRANSPORT_ERROR") from None
+        except json.JSONDecodeError:
+            raise TransientAPIError("GO_INVALID_JSON_RESPONSE") from None
+
+    def refresh_quota(self):
+        for attempt in range(6):
+            try:
+                quota, _ = self._http(USAGE_ENDPOINT)
+                break
+            except TransientAPIError:
+                if attempt == 5:
+                    raise
+                time.sleep(retry_delay(attempt))
+        self.quota, self.quota_time, self.quota_spent = quota, time.monotonic(), self.spent
+        return quota
+
+    def reserve(self, worst):
+        with self.lock:
+            if self.quota is None or time.monotonic() - self.quota_time > 45:
+                self.refresh_quota()
+            if self.spent + self.reserved + worst > self.max_usd:
+                raise RuntimeError("RUN_API_BUDGET_HOLD")
+            for window, allowance in [("rolling", 12.0), ("weekly", 30.0), ("monthly", 60.0)]:
+                state = self.quota.get("usage", {}).get(window, {})
+                percent = state.get("percent")
+                estimate = self.spent - self.quota_spent + self.reserved + worst
+                if (state.get("status") != "ok" or not isinstance(percent, (int, float))
+                        or percent + estimate / allowance * 100 >= 90):
+                    raise RuntimeError("GO_QUOTA_HOLD_" + window)
+            self.reserved += worst
+
+    def complete(self, group):
+        body = protocol.request_body(group)
+        identity = protocol.digest({"body": body, "protocol": protocol.VERSION, "endpoint": ENDPOINT})
+        cache = self.cache / (identity + ".json")
+        if cache.exists():
+            saved = json.loads(cache.read_text())
+            assert saved["request_sha256"] == identity
+            return saved
+        # Bytes >= token count is a deliberately conservative no-overage reserve.
+        worst = (len(json.dumps(body).encode()) * .15 + body["max_tokens"] * .5) / 1e6
+        start = time.monotonic()
+        for attempt in range(6):
+            self.reserve(worst)
+            attempt_id = uuid.uuid4().hex
+            attempt_path = self.attempt_dir / (attempt_id + ".json")
+            ledger = {"attempt_id": attempt_id, "request_sha256": identity,
+                      "status": "pending", "price_upper_usd": worst, "time": time.time()}
+            atomic_json(attempt_path, ledger)
+            try:
+                payload, billing = self._http(ENDPOINT, body)
+                break
+            except Exception as exc:
+                ledger["status"] = "uncertain_response"
+                atomic_json(attempt_path, ledger)
+                with self.lock:
+                    self.reserved -= worst
+                    self.spent += worst
+                if not isinstance(exc, TransientAPIError) or attempt == 5:
+                    raise
+                print(json.dumps({"event": "api_retry", "request_sha256": identity,
+                                  "attempt": attempt + 1, "delay_s": retry_delay(attempt),
+                                  "error": str(exc)}), flush=True)
+                time.sleep(retry_delay(attempt))
+        usage = payload.get("usage", {})
+        if not all(isinstance(usage.get(k), int) and usage[k] >= 0 for k in ("prompt_tokens", "completion_tokens")):
+            ledger["status"] = "usage_unknown"
+            atomic_json(attempt_path, ledger)
+            with self.lock:
+                self.reserved -= worst
+                self.spent += worst
+            raise RuntimeError("API_USAGE_MISSING")
+        cost = (usage["prompt_tokens"] * .15 + usage["completion_tokens"] * .5) / 1e6
+        choice = payload.get("choices", [{}])[0]
+        content = choice.get("message", {}).get("content")
+        result = {"request_sha256": identity, "attempt_id": attempt_id,
+                  "episode_key": group["key"], "schema": protocol.VERSION,
+                  "response_model": payload.get("model"), "billing_source": billing,
+                  "content": content, "finish_reason": choice.get("finish_reason"), "usage": usage,
+                  "elapsed_s": time.monotonic() - start, "time": time.time(),
+                  "uncached_price_upper_usd": cost,
+                  "outputs": protocol.parse_hints(content, group, choice.get("finish_reason"))}
+        atomic_json(cache, result)
+        ledger["status"] = "cached"
+        atomic_json(attempt_path, ledger)
+        with self.lock:
+            self.reserved -= worst
+            self.spent += cost
+            self.calls += 1
+        return result
+
+
+def run(payload, output_path, auth, cache, max_usd=22.0):
+    groups = payload.get("groups") or protocol.group_requests(payload["requests"])
+    execution = execution_settings(payload, output_path)
+    print(json.dumps({"event": "api_execution_config", **execution}), flush=True)
+    client = GoClient(auth, cache, max_usd=max_usd)
+    started = time.monotonic()
+    outputs, records = {}, []
+    quota_before = client.refresh_quota()
+    with ThreadPoolExecutor(max_workers=execution["effective_concurrency"]) as pool:
+        pending = {pool.submit(client.complete, g): g for g in groups}
+        for future in as_completed(pending):
+            try:
+                result = future.result()
+            except Exception:
+                for f in pending:
+                    f.cancel()
+                raise
+            outputs.update(result["outputs"])
+            records.append({k: v for k, v in result.items() if k not in {"content", "outputs"}})
+            print(json.dumps({"completed_episodes": len(records), "total_episodes": len(groups),
+                              "hints": len(result["outputs"]), "elapsed_s": round(result["elapsed_s"], 2)}), flush=True)
+    # Completed hints must not be thrown away because the telemetry endpoint
+    # briefly disconnects after all inference has already succeeded.
+    try:
+        quota_after = client.refresh_quota()
+    except (TransientAPIError, RuntimeError) as exc:
+        quota_after = {"status": "unavailable", "error_type": type(exc).__name__}
+    result = {"request_sha256": payload.get("request_sha256"), "outputs": outputs,
+              "episode_records": records, "grouped_requests": len(groups), "api_calls_this_run": client.calls,
+              "uncached_price_upper_usd": sum(r["uncached_price_upper_usd"] for r in records),
+              "prompt_tokens": sum(r["usage"]["prompt_tokens"] for r in records),
+              "completion_tokens": sum(r["usage"]["completion_tokens"] for r in records),
+              "quota_before": quota_before, "quota_after": quota_after,
+              "elapsed_s": time.monotonic() - started, "actor_route_changed_by_analyzer": False,
+              "student_sees_hint": False, "schema": protocol.VERSION,
+              "execution": execution}
+    atomic_json(output_path, result)
+    return result
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("request")
+    parser.add_argument("output")
+    parser.add_argument("--auth", required=True)
+    parser.add_argument("--cache", required=True)
+    parser.add_argument("--max-usd", type=float, default=22)
+    args = parser.parse_args()
+    auth_path = Path(args.auth)
+    if auth_path.stat().st_mode & 0o077:
+        raise RuntimeError("API_AUTH_PERMISSIONS_TOO_OPEN")
+    try:
+        run(json.loads(Path(args.request).read_text()), args.output,
+            json.loads(auth_path.read_text()), args.cache, args.max_usd)
+    except TransientAPIError as exc:
+        atomic_json(args.output + ".status.json", {"status": "retryable", "error": str(exc), "time": time.time()})
+        raise SystemExit(75)
+    except RuntimeError as exc:
+        code = str(exc)
+        safe = code if code.startswith(("GO_", "RUN_API_", "BILLING_", "API_USAGE_")) else "API_WORKER_ERROR"
+        atomic_json(args.output + ".status.json", {"status": "hold", "error": safe, "time": time.time()})
+        raise SystemExit(76 if safe != "API_WORKER_ERROR" else 1)
