+++ b/verl/trainer/ppo/rethink_local_analyzer.py
@@ -0,0 +1,61 @@
+"""Frozen Decision Analyzer subprocess; no Teacher/Actor replacement or API."""
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+
+def main():
+    import inspect
+    import torch
+    from transformers import AutoModelForCausalLM, AutoTokenizer
+    from verl.trainer.ppo.rethink_local_hints import atomic_json
+
+    request_path, output_path = (Path(x).resolve() for x in sys.argv[1:])
+    if output_path.exists():
+        raise FileExistsError("Never overwrite an existing Analyzer result")
+    data = json.loads(request_path.read_text(encoding="utf-8"))
+    model_path = Path(data["model_path"]).resolve()
+    for relative, expected in data["identity_files"].items():
+        path = (model_path / relative).resolve()
+        if not path.is_relative_to(model_path) or hashlib.sha256(path.read_bytes()).hexdigest() != expected:
+            raise ValueError("Analyzer manifest/protocol identity mismatch")
+    if torch.cuda.device_count() != 1 or torch.cuda.mem_get_info()[0] < 9 * 1024**3:
+        raise RuntimeError("Select one allocated Analyzer GPU with sufficient free memory")
+    # Keep the frozen exported weights/identity. Replace its classification
+    # prompt/parser with the explicitly authorized, versioned hint-only role.
+    from verl.trainer.ppo.rethink_hint_protocol import (
+        VERSION, ASSISTANT_PREFIX, prompt_token_ids, parse_response)
+    protocol = Path(__file__).with_name("rethink_hint_protocol.py")
+    if data.get("schema") != VERSION or data.get("hint_protocol_sha256") != hashlib.sha256(protocol.read_bytes()).hexdigest():
+        raise ValueError("Hint-only prompt/schema identity mismatch")
+    tokenizer = AutoTokenizer.from_pretrained(model_path, local_files_only=True)
+    model = AutoModelForCausalLM.from_pretrained(model_path, torch_dtype=torch.bfloat16,
+        attn_implementation="sdpa", local_files_only=True).to("cuda").eval().requires_grad_(False)
+    parameters = inspect.signature(model.forward).parameters
+    key = "logits_to_keep" if "logits_to_keep" in parameters else "num_logits_to_keep"
+    if key not in parameters:
+        raise RuntimeError("Analyzer backend cannot limit generation logits")
+    outputs = {}
+    for record in data["requests"]:
+        ids = prompt_token_ids(tokenizer, record["episode"], record["target"])
+        if len(ids) + data["max_new_tokens"] > 16384:
+            outputs[record["key"]] = {"payload": None, "error": "analyzer_context_limit"}
+            continue
+        inputs = torch.tensor([ids], device="cuda")
+        with torch.inference_mode():
+            tokens = model.generate(input_ids=inputs, attention_mask=torch.ones_like(inputs),
+                max_new_tokens=data["max_new_tokens"], do_sample=data["do_sample"],
+                pad_token_id=tokenizer.pad_token_id, eos_token_id=tokenizer.eos_token_id, **{key: 1})
+        generated = tokens[0, len(ids):].tolist()
+        text = ASSISTANT_PREFIX + tokenizer.decode(generated, skip_special_tokens=False)
+        outputs[record["key"]] = {"payload": parse_response(text), "response": text,
+                                  "generated_token_ids": generated,
+                                  "analyzer_only_output_prefix": ASSISTANT_PREFIX}
+    atomic_json(output_path, {"request_sha256": data["request_sha256"], "outputs": outputs,
+                             "analyzer_frozen": True, "teacher_only": True, "external_api_calls": 0,
+                             "hint_protocol": VERSION, "analyzer_decision_gate": False})
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verl/trainer/ppo/rethink_local_hints.py b/verl/trainer/ppo/rethink_local_hints.py
new file mode 100644
--- /dev/null
+++ b/verl/trainer/ppo/rethink_local_hints.py
@@ -0,0 +1,272 @@
+"""Teacher-only hints; leave SDAR prompts, execution, rewards and scoring intact."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import time
+
+import numpy as np
+
+from verl.trainer.ppo.rethink_hint_protocol import VERSION as HINT_PROTOCOL
+from verl.trainer.ppo.rethink_benchmark_contract import benchmark, command_allowed, hint_command
+
+MARKER = "<RETHINK>"
+HINT_BEGIN = "[Actor-triggered local hint]"
+HINT_END = "[End local hint]"
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, ensure_ascii=False,
+                                    separators=(",", ":")).encode()).hexdigest()
+
+
+def atomic_json(path, value):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    pending = path.with_name(path.name + ".pending")
+    with pending.open("w", encoding="utf-8") as stream:
+        json.dump(value, stream, ensure_ascii=False, indent=2)
+        stream.flush()
+        os.fsync(stream.fileno())
+    pending.replace(path)
+
+
+def capture_inputs(envs, observations=None, infos=None):
+    # Observe only; never replace the environment's projection or step method.
+    name = type(envs).__name__.lower()
+    if "webshop" in name:
+        if observations is None or infos is None:
+            raise ValueError("WebShop hint capture needs current observation and infos")
+        commands = [envs.format_avail_actions(info["available_actions"]) for info in infos]
+        return list(observations["anchor"]), commands, "webshop"
+    if "search" in name:
+        if observations is None:
+            raise ValueError("Search hint capture needs current observation")
+        return list(observations["anchor"]), [[] for _ in observations["anchor"]], "search"
+    return list(envs.pre_text_obs), [list(x) for x in envs.envs.get_admissible_commands]
+
+
+def record_step(batch, tokenizer, before, next_obs, infos, envs):
+    marker_ids = tokenizer.encode(MARKER, add_special_tokens=False)
+    if len(marker_ids) != 1 or tokenizer.decode(marker_ids, skip_special_tokens=False) != MARKER:
+        raise ValueError("Actor must have the registered single RETHINK token")
+    records, flags = [], []
+    environment = before[2] if len(before) == 3 else "alfworld"
+    for i, response in enumerate(batch.batch["responses"]):
+        mask = batch.batch["attention_mask"][i, -len(response):].bool()
+        ids = response[mask].tolist()
+        text = tokenizer.decode(ids, skip_special_tokens=False)
+        reasoning = re.search(r"<think>(.*?)</think>", text, re.S)
+        flags.append(marker_ids[0] in ids)
+        # Use the action actually selected by the unchanged public projection.
+        records.append(json.dumps({
+            "observation": before[0][i], "admissible_actions": before[1][i],
+            "reasoning": reasoning[1].strip() if reasoning else text,
+            "action": envs.memory[i][-1]["search" if environment == "search" else "action"],
+            "feedback": next_obs["anchor"][i], "won": bool(infos[i].get("won", False)),
+            "actor_rethink": flags[-1], "marker_count": ids.count(marker_ids[0]),
+            **({"benchmark": environment} if environment != "alfworld" else {}),
+        }, ensure_ascii=False))
+    batch.non_tensor_batch["rh_step_record"] = np.array(records, dtype=object)
+    batch.non_tensor_batch["rh_actor_rethink"] = np.array(flags, dtype=bool)
+
+
+def finish_episodes(batches, lengths, tasks):
+    for rows, length, task in zip(batches, lengths, tasks, strict=True):
+        active = [(j, row) for j, row in enumerate(rows) if bool(row["active_masks"])]
+        if len(active) != int(length):
+            raise RuntimeError("Incomplete trajectory evidence for local Analyzer")
+        steps = []
+        environment = "alfworld"
+        for j, row in active:
+            record = json.loads(row.pop("rh_step_record"))
+            current_environment = benchmark(record.get("benchmark", "alfworld"))
+            if steps and current_environment != environment:
+                raise RuntimeError("Mixed benchmarks within a trajectory")
+            environment = current_environment
+            steps.append({"step": j, **{key: record[key] for key in (
+                "observation", "admissible_actions", "reasoning", "action", "feedback")}})
+        episode = json.dumps({"task": task, "steps": steps, "target_steps": [],
+                              **({"benchmark": environment} if environment != "alfworld" else {})}, ensure_ascii=False)
+        for j, row in active:
+            row["rh_episode"], row["rh_step"] = episode, j
+
+
+def accepted_hint(payload, commands, environment="alfworld"):
+    if not isinstance(payload, dict):
+        return None, "invalid_analyzer_output"
+    skill = payload.get("reasoning_skill")
+    if not isinstance(skill, str) or not skill.strip():
+        return None, "invalid_analyzer_output"
+    if benchmark(environment) != "alfworld":
+        selected = hint_command(skill)
+        if selected is None or not command_allowed(selected, commands, environment):
+            return None, "hint_command_not_admissible"
+    command = re.search(r'Next command\s*:\s*["\']([^"\']+)["\']', skill, re.I)
+    if environment == "alfworld" and command and command[1].strip() not in commands:
+        return None, "hint_command_not_admissible"
+    if HINT_BEGIN in skill or HINT_END in skill:
+        return None, "invalid_analyzer_output"
+    # Actor already chose the route. No quality label or error accusation is
+    # required; a sound plan can receive useful confirming/local guidance too.
+    return "Reasoning skill: " + skill.strip(), None
+
+
+class RoutedSkills:
+    def __init__(self, native, hints):
+        self.native, self.hints, self.cursor = native, hints, 0
+
+    def _next(self, text):
+        if self.cursor >= len(self.hints):
+            raise RuntimeError("Teacher hint row alignment failed")
+        hint = self.hints[self.cursor]
+        self.cursor += 1
+        return text if hint is None else text + "\n\n" + HINT_BEGIN + "\n" + hint + "\n" + HINT_END
+
+    def get_privileged_info(self, *args):
+        return self._next(self.native.get_privileged_info(*args))
+
+    def get_privileged_info_from_data_source(self, *args):
+        return self._next(self.native.get_privileged_info_from_data_source(*args))
+
+    def get_privileged_info_from_prompt(self, *args):
+        return self._next(self.native.get_privileged_info_from_prompt(*args))
+
+
+def generate_hints(trainer, batch):
+    started = time.monotonic()
+    cfg = trainer.config.algorithm.local_hints
+    root = Path(cfg.run_root).resolve()
+    requests, row_keys = {}, []
+    for i in range(len(batch)):
+        if not bool(batch.non_tensor_batch["rh_actor_rethink"][i]):
+            row_keys.append(None)
+            continue
+        episode = json.loads(batch.non_tensor_batch["rh_episode"][i])
+        target = int(batch.non_tensor_batch["rh_step"][i])
+        episode["target_steps"] = [target]
+        key = digest({"episode": episode, "target": target})
+        requests.setdefault(key, {"key": key, "episode": episode, "target": target})
+        row_keys.append(key)
+    # Bind reuse to prompts, model/protocol identities, and generation settings.
+    payload = {"requests": list(requests.values()), "model_path": str(cfg.analyzer_path),
+               "identity_files": dict(cfg.identity_files), "max_new_tokens": 512,
+               "do_sample": False, "schema": HINT_PROTOCOL,
+               "hint_protocol_sha256": hashlib.sha256(
+                   Path(__file__).with_name("rethink_hint_protocol.py").read_bytes()).hexdigest()}
+    api_backend = cfg.get("backend", "local") == "go_glm_episode"
+    if not api_backend and any(r["episode"].get("benchmark", "alfworld") != "alfworld" for r in requests.values()):
+        raise ValueError("Cross-benchmark hints require the adapted API backend, not the ALFWorld-only local Analyzer")
+    if cfg.get("backend", "local") not in {"local", "go_glm_episode"}:
+        raise ValueError("Unknown hint backend")
+    if api_backend:
+        from verl.trainer.ppo.rethink_api_protocol import VERSION, MODEL
+        payload = {"requests": list(requests.values()), "schema": VERSION, "model": MODEL,
+                   "backend": "go_glm_episode", "concurrency": 2, "temperature": 0,
+                   "reasoning_effort": "low", "source_sha256": {
+                       name: hashlib.sha256(Path(__file__).with_name(name).read_bytes()).hexdigest()
+                       for name in ["rethink_api_protocol.py", "rethink_api_hints.py", "rethink_benchmark_contract.py"]}}
+    identity = digest(payload)
+    payload["request_sha256"] = identity
+    stem = root / "ipc" / f"update_{trainer.global_steps:06d}_{identity}"
+    request_path, output_path = stem.with_suffix(".requests.json"), stem.with_suffix(".results.json")
+    if requests and not output_path.exists():
+        atomic_json(request_path, payload)
+        env = os.environ.copy()
+        env["CUDA_VISIBLE_DEVICES"] = "" if api_backend else str(cfg.device)
+        if api_backend:
+            command = [sys.executable, os.environ.get("RETHINK_API_WORKER", str(Path(__file__).with_name("rethink_api_hints.py"))),
+                       str(request_path), str(output_path), "--auth", str(cfg.api_auth_file),
+                       "--cache", str(root / "api_cache"), "--max-usd", str(cfg.api_max_usd)]
+        else:
+            command = [sys.executable, "-m", "verl.trainer.ppo.rethink_local_analyzer",
+                       str(request_path), str(output_path)]
+        with stem.with_suffix(".analyzer.log").open("ab", buffering=0) as log:
+            while True:
+                try:
+                    subprocess.run(command, env=env, check=True,
+                                   stdout=log, stderr=subprocess.STDOUT, timeout=7200)
+                    break
+                except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
+                    if not api_backend:
+                        raise
+                    code = exc.returncode if isinstance(exc, subprocess.CalledProcessError) else 75
+                    if code not in {75, 76}:
+                        raise RuntimeError("API_WORKER_INTEGRITY_FAILURE_SEE_PRIVATE_LOG") from None
+                    # Keep the same rollout and pre-update Actor in memory.
+                    # Quota/auth holds never become paid requests or silent
+                    # episode-only fallback. Cached successful calls are reused.
+                    atomic_json(root / "api_wait_status.json", {
+                        "status": "waiting_retry" if code == 75 else "waiting_quota_or_auth",
+                        "step": trainer.global_steps, "time": time.time(),
+                        "retry_after_s": 60 if code == 75 else 300,
+                        "request_sha256": identity})
+                    print("[Recovery] API waiting; same batch retained, no Actor update", flush=True)
+                    time.sleep(60 if code == 75 else 300)
+            atomic_json(root / "api_wait_status.json", {
+                "status": "ready", "step": trainer.global_steps, "time": time.time()})
+    result = json.loads(output_path.read_text(encoding="utf-8")) if requests else {
+        "request_sha256": identity, "outputs": {}}
+    if result["request_sha256"] != identity or set(result["outputs"]) != set(requests):
+        raise RuntimeError("Analyzer result identity/coverage mismatch")
+    hints, fallback = [], {}
+    for key in row_keys:
+        if key is None:
+            hints.append(None)
+            continue
+        record = requests[key]
+        target_step = next(s for s in record["episode"]["steps"] if s["step"] == record["target"])
+        output = result["outputs"][key]
+        hint, reason = accepted_hint(output["payload"], target_step["admissible_actions"],
+                                     record["episode"].get("benchmark", "alfworld"))
+        if hint is None and output.get("error"):
+            reason = output["error"]
+        hints.append(hint)
+        if reason:
+            fallback[reason] = fallback.get(reason, 0) + 1
+    report = {"step": trainer.global_steps, "rows": len(batch), "unique_analyzer_requests": len(requests),
+              "actor_marker_rows": sum(k is not None for k in row_keys),
+              "teacher_local_hint_rows": sum(h is not None for h in hints), "fallback_counts": fallback,
+              "actor_route_changed_by_analyzer": False, "student_sees_hint": False,
+              "fixed_initial_teacher": False, "teacher_scoring": "public_pre_update_current_actor",
+              "external_api_calls": result.get("api_calls_this_run", 0),
+              "hint_protocol": payload["schema"], "backend": cfg.get("backend", "local"),
+              "episode_grouped_requests": result.get("grouped_requests", 0),
+              "api_prompt_tokens": result.get("prompt_tokens", 0),
+              "api_completion_tokens": result.get("completion_tokens", 0),
+              "api_uncached_price_upper_usd": result.get("uncached_price_upper_usd", 0),
+              "analyzer_decision_gate": False, "analyzer_role": "hint_only",
+              "local_hint_elapsed_s": time.monotonic() - started}
+    atomic_json(root / "reports" / f"hint_usage_{trainer.global_steps:06d}.json", report)
+    return hints
+
+
+def score_with_local_hints(trainer, batch):
+    from verl.trainer.ppo.rlsd_ray_trainer import build_teacher_batch
+    hints = generate_hints(trainer, batch)
+    if not any(h is not None for h in hints):
+        return trainer._compute_teacher_log_probs(batch)
+    provider = RoutedSkills(trainer.skill_provider, hints)
+    teacher_batch = build_teacher_batch(
+        batch=batch, skill_provider=provider, tokenizer=trainer.tokenizer,
+        max_prompt_length=trainer.config.data.max_prompt_length,
+        truncation=trainer.config.data.get("truncation", "left"))
+    if provider.cursor != len(batch):
+        raise RuntimeError("Teacher hint row alignment failed")
+    # Keep the public Teacher context limit and truncation. Fail visibly instead
+    # of silently claiming to use a local hint which was entirely/partly cut.
+    length = batch.batch["responses"].shape[1]
+    for i, hint in enumerate(hints):
+        if hint is None:
+            continue
+        ids = teacher_batch.batch["input_ids"][i, :-length]
+        mask = teacher_batch.batch["attention_mask"][i, :-length].bool()
+        prompt = trainer.tokenizer.decode(ids[mask].tolist(), skip_special_tokens=False)
+        if HINT_BEGIN + "\n" + hint + "\n" + HINT_END not in prompt:
+            raise RuntimeError("Public Teacher prompt budget truncates local hint; stop, do not change limits silently")
+    # Same Actor worker, timing, temperature, response tokens and score cache as
+    # public SDAR. No fixed Teacher, full-vocabulary logits, or extra optimizer.
+    return trainer.actor_rollout_wg.compute_log_prob(teacher_batch).batch["old_log_probs"]
