+"""Optional task binding for repeated validation, not a training change."""
+from copy import copy
+import json
+import os
+from pathlib import Path
+
+
+def fixed_validation_envs(base_env, manifest, count, group_n):
+    if group_n != 1:
+        raise ValueError('Fixed validation requires exactly one rollout per task')
+    rows = json.loads(Path(manifest).read_text(encoding='utf-8'))
+    if len(rows) != count or len({row['task_id'] for row in rows}) != count:
+        raise ValueError('Fixed validation task count or uniqueness mismatch')
+    root = Path(os.environ['ALFWORLD_DATA']).resolve()
+    available = {Path(x).resolve() for x in base_env.game_files}
+    result = []
+    for row in rows:
+        task = Path(row['task_id'])
+        game = (root / task).resolve()
+        if (not game.is_relative_to(root / 'json_2.1.1/valid_seen')
+                or game not in available or not game.is_file()):
+            raise ValueError('Fixed validation task is not in the held-out game pool')
+        selected = copy(base_env)
+        selected.game_files = [str(game)]
+        selected.num_games = 1
+        selected.fixed_validation_seed = int(row['seed'])
+        result.append(selected)
+    return result
